    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera scannt Belege, Warnleuchten und Schäden, damit du sie nicht eintippen musst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera scans receipts, dashboard warning lights and damage so you don't have to type them in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara escanea tickets, testigos del tablero y daños para que no tengas que escribirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo scanne tickets, voyants du tableau de bord et dégâts pour vous éviter de les saisir."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparat skanuje paragony, kontrolki na desce i uszkodzenia, żebyś nie musiał ich wpisywać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера сканирует чеки, индикаторы на приборной панели и повреждения, чтобы не вводить их вручную."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Foto eines Belegs oder Dokuments, um es deinem Auto hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a photo of a receipt or a document to attach it to your car."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una foto de un ticket o un documento para añadirla a tu coche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la photo d’un ticket ou d’un document pour l’ajouter à votre voiture."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz zdjęcie paragonu lub dokumentu, aby dodać je do auta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите фото чека или документа, чтобы прикрепить его к автомобилю."
          }
        }
      }
    }
