        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detente en un lugar seguro y comprueba el nivel de aceite. Si está bajo, no sigas conduciendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez-vous en sécurité et vérifiez le niveau d’huile. S’il est bas, ne roulez plus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpiecznie się zatrzymaj i sprawdź poziom oleju. Jeśli jest niski, nie jedź dalej."
