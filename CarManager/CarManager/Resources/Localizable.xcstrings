    "A receipt is saved to a vehicle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Beleg wird einem Fahrzeug zugeordnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ticket se guarda en un vehículo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ticket est enregistré sur un véhicule."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paragon zapisuje się do auta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чек сохраняется к автомобилю."
          }
        }
      }
    },
    "A red or flashing light can mean stop now. When in doubt, stop safely and call a mechanic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine rote oder blinkende Leuchte kann „sofort anhalten“ bedeuten. Im Zweifel sicher anhalten und eine Werkstatt anrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un testigo rojo o intermitente puede significar parar ya. Ante la duda, detente con seguridad y llama a un mecánico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un voyant rouge ou clignotant peut signifier de s’arrêter tout de suite. En cas de doute, arrêtez-vous en sécurité et appelez un mécanicien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czerwona lub migająca kontrolka może oznaczać: zatrzymaj się teraz. W razie wątpliwości bezpiecznie stań i zadzwoń do mechanika."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Красный или мигающий индикатор может означать «остановитесь сейчас». Если сомневаетесь — безопасно остановитесь и позвоните механику."
          }
        }
      }
    },
