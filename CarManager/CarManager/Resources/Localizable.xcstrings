      }
    },
    "It judges only what is visible. Hidden or structural damage may be missed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewertet wird nur Sichtbares. Verdeckte oder strukturelle Schäden können übersehen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo juzga lo visible. Pueden pasarse por alto daños ocultos o estructurales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le visible est évalué. Des dégâts cachés ou structurels peuvent passer inaperçus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocenia tylko to, co widać. Ukryte lub strukturalne uszkodzenia mogą umknąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценивается только видимое. Скрытые или структурные повреждения можно не заметить."
          }
        }
      }
    },
    "It may have been deleted on another device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde vielleicht auf einem anderen Gerät gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que se haya eliminado en otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a peut-être été supprimé sur un autre appareil."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mógł zostać usunięty na innym urządzeniu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, его удалили на другом устройстве."
          }
        }
      }
    },
    "It may still be downloading, or it was removed from this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird vielleicht noch geladen oder wurde von diesem Gerät entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que aún se esté descargando o que se haya eliminado de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est peut-être encore en téléchargement ou a été supprimé de cet appareil."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może się jeszcze pobierać albo został usunięty z tego urządzenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, он ещё загружается или был удалён с этого устройства."
          }
        }
      }
    },
    "It sees only what is in the photo — it cannot read fault codes or hear the engine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sieht nur, was auf dem Foto ist — Fehlercodes kann sie nicht lesen, den Motor nicht hören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo ve lo que hay en la foto: no puede leer códigos de error ni oír el motor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne voit que ce qui est sur la photo : elle ne lit pas les codes défaut et n’entend pas le moteur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widzi tylko to, co na zdjęciu — nie odczyta kodów błędów ani nie usłyszy silnika."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он видит только то, что на фото, — не читает коды ошибок и не слышит двигатель."
          }
        }
      }
    },
    "Its fuel, service, expenses and documents are deleted from iCloud too. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanken, Service, Ausgaben und Dokumente werden auch aus iCloud gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus repostajes, mantenimientos, gastos y documentos también se eliminan de iCloud. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses pleins, entretiens, dépenses et documents sont aussi supprimés d’iCloud. C’est irréversible."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego tankowania, serwisy, wydatki i dokumenty zostaną też usunięte z iCloud. Tego nie da się cofnąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его заправки, обслуживание, расходы и документы тоже удалятся из iCloud. Это нельзя отменить."
          }
        }
      }
    },
    "Its notifications are cancelled too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Mitteilungen werden ebenfalls entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its notifications are canceled too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its notifications are cancelled too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se cancelan sus notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses notifications sont aussi annulées."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego powiadomienia też zostaną anulowane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его уведомления тоже будут отменены."
          }
        }
      }
    },
    "Keep insurance, registration and receipts here. Expiry dates become reminders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre hier Versicherung, Zulassung und Belege auf. Ablaufdaten werden zu Erinnerungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda aquí seguros, permisos y tickets. Las fechas de caducidad se convierten en recordatorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez ici assurance, carte grise et tickets. Les dates d’expiration deviennent des rappels."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj tu ubezpieczenie, dowód rejestracyjny i paragony. Daty ważności staną się przypomnieniami."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните здесь страховку, СТС и чеки. Сроки действия станут напоминаниями."
          }
        }
      }
    },
