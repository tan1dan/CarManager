    "Chat about your car, scan a dashboard warning light or a dent. Answers are guidance, not a mechanic's diagnosis." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatte über dein Auto, scanne eine Warnleuchte oder eine Delle. Die Antworten sind Orientierung, keine Werkstattdiagnose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habla de tu coche, escanea un testigo del tablero o una abolladura. Las respuestas son orientativas, no el diagnóstico de un mecánico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discutez de votre voiture, scannez un voyant ou une bosse. Les réponses sont indicatives, pas un diagnostic de mécanicien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmawiaj o aucie, skanuj kontrolki na desce lub wgniecenia. Odpowiedzi to wskazówki, a nie diagnoza mechanika."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обсудите своё авто, отсканируйте индикатор на панели или вмятину. Ответы — подсказки, а не диагноз механика."
          }
        }
      }
    },
    "Check before saving. These values were read from the photo and may be wrong." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Speichern prüfen. Die Werte stammen aus dem Foto und können falsch sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa antes de guardar. Estos valores se han leído de la foto y pueden estar mal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez avant d’enregistrer. Ces valeurs viennent de la photo et peuvent être fausses."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź przed zapisaniem. Te wartości odczytano ze zdjęcia i mogą być błędne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте перед сохранением. Значения прочитаны с фото и могут быть неточными."
          }
        }
      }
    },
