    "Amounts are never converted: a car's totals only count records in that car's currency." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beträge werden nie umgerechnet: Die Summen eines Autos zählen nur Einträge in seiner Währung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los importes nunca se convierten: los totales de un coche solo cuentan registros en su divisa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les montants ne sont jamais convertis : les totaux d’une voiture ne comptent que les données dans sa devise."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwoty nigdy nie są przeliczane: sumy auta obejmują tylko wpisy w jego walucie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суммы никогда не пересчитываются: итоги автомобиля учитывают только записи в его валюте."
          }
        }
      }
    },
    "Amounts in another currency are converted at the official rate." : {
