    "Used for cars you add from now on. A car keeps the currency it was created with, so its history never gets converted at a made-up rate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Autos, die du ab jetzt hinzufügst. Jedes Auto behält seine ursprüngliche Währung — sein Verlauf wird nie zu einem erfundenen Kurs umgerechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para los coches que añadas a partir de ahora. Cada coche conserva la divisa con la que se creó, para que su historial nunca se convierta a un tipo inventado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux voitures ajoutées désormais. Chaque voiture garde la devise de sa création : son historique n’est jamais converti à un taux inventé."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy aut dodanych od teraz. Każde auto zachowuje walutę, w której je utworzono, więc jego historia nigdy nie jest przeliczana po wymyślonym kursie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для автомобилей, которые вы добавите дальше. Каждый автомобиль сохраняет валюту, в которой был создан, — его история не пересчитывается по выдуманному курсу."
          }
        }
      }
    },
    "Valid to %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
