    "Tap + and photograph a receipt. AI reads the amount, litres and date, converts foreign currency — you check it and save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf + und fotografiere einen Beleg. Die KI liest Betrag, Liter und Datum und rechnet Fremdwährungen um — du prüfst und speicherst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap + and photograph a receipt. AI reads the amount, liters and date, converts foreign currency — you check it and save."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap + and photograph a receipt. AI reads the amount, litres and date, converts foreign currency — you check it and save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + y fotografía un ticket. La IA lee el importe, los litros y la fecha y convierte otras divisas; tú lo revisas y guardas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + et photographiez un ticket. L’IA lit le montant, les litres et la date, convertit les devises — vous vérifiez et enregistrez."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij + i zrób zdjęcie paragonu. AI odczyta kwotę, litry i datę oraz przeliczy obcą walutę — Ty sprawdzasz i zapisujesz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите + и сфотографируйте чек. AI прочитает сумму, литры и дату и переведёт валюту — вам останется проверить и сохранить."
          }
        }
      }
    },
