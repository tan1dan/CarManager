    "Insurance, parking, tolls, car washes — log them and see where the money goes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versicherung, Parken, Maut, Autowäsche — erfasse sie und sieh, wohin das Geld geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguro, aparcamiento, peajes, lavados: regístralos y mira en qué se va el dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurance, parking, péages, lavages : enregistrez-les et voyez où va l’argent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubezpieczenie, parking, autostrady, myjnia — zapisuj i zobacz, na co idą pieniądze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страховка, парковка, платные дороги, мойка — записывайте и смотрите, куда уходят деньги."
          }
        }
      }
    },
    "Insurance, registration, receipts" : {
      "localizations" : {
        "de" : {
