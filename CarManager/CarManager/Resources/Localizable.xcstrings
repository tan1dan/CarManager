    "Advice will be general. Mention the make, model and year if you want it more specific. The assistant remembers this conversation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ratschläge bleiben allgemein. Nenne Marke, Modell und Baujahr für genauere Antworten. Der Assistent merkt sich diesen Chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los consejos serán generales. Indica marca, modelo y año si quieres más precisión. El asistente recuerda esta conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conseils resteront généraux. Indiquez la marque, le modèle et l’année pour plus de précision. L’assistant se souvient de cette conversation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porady będą ogólne. Podaj markę, model i rok, jeśli chcesz konkretniej. Asystent pamięta tę rozmowę."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Советы будут общими. Укажите марку, модель и год, чтобы ответ был точнее. Ассистент помнит этот разговор."
          }
        }
      }
    },
