    "Add a reminder by date or by mileage and we'll warn you in time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge eine Erinnerung nach Datum oder Kilometerstand hinzu — wir warnen dich rechtzeitig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un recordatorio por fecha o por kilometraje y te avisaremos a tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un rappel par date ou kilométrage, nous vous préviendrons à temps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj przypomnienie według daty lub przebiegu, a ostrzeżemy Cię na czas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте напоминание по дате или пробегу — мы предупредим вовремя."
          }
        }
      }
    },
