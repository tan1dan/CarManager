    "%@ keep their current currency, so their history and statistics stay exactly as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ behalten ihre aktuelle Währung, Verlauf und Statistik bleiben also genau so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ conservan su divisa actual, así que su historial y sus estadísticas se quedan exactamente igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gardent leur devise actuelle : leur historique et leurs statistiques restent identiques."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zachowają obecną walutę, więc historia i statystyki pozostaną bez zmian."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сохранят текущую валюту, поэтому история и статистика останутся без изменений."
          }
        }
      }
    },
